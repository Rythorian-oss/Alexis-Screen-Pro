<Window x:Class="AlexisScreenPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alexis Screen Pro"
        Width="460"
        Height="720"
        MinWidth="460"
        MinHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F9" Command="{Binding ToggleRecordingCommand}" />
    </Window.InputBindings>

    <Grid x:Name="WindowShadowHost"
          Margin="20"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate" Y="0" />
        </Grid.RenderTransform>

        <Border x:Name="GlassFrame"
                CornerRadius="26"
                Background="{StaticResource WindowGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                Effect="{StaticResource WindowShadowEffect}">
            <Grid x:Name="GlassContent">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,418,678" RadiusX="25" RadiusY="25" />
                </Grid.Clip>

                <!-- Backdrop atmosphere -->
                <Border Background="{StaticResource HeroGlowBrush}"
                        CornerRadius="25"
                        IsHitTestVisible="False" />
                <Border Background="{StaticResource CyanGlowBrush}"
                        CornerRadius="25"
                        Opacity="0.7"
                        IsHitTestVisible="False" />
                <Border Background="{StaticResource GlassSheenBrush}"
                        CornerRadius="25"
                        IsHitTestVisible="False" />
                <Border Height="1"
                        VerticalAlignment="Top"
                        Margin="54,0"
                        Background="#4D8FC4FF"
                        IsHitTestVisible="False" />

                <Grid Margin="20,14,20,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="148" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="116" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="152" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>

                    <!-- ================= HEADER ================= -->
                    <Grid Grid.Row="0"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                          Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="9"
                                    Background="#261D5BFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1">
                                <Image Source="pack://application:,,,/AlexisScreenPro;component/Assets/logo.png"
                                       Margin="2"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ALEXIS"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="  SCREEN"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="PRECISION CAPTURE"
                                           FontSize="7.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>

                            <Border Margin="9,0,0,0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="#261D5BFF"
                                    BorderBrush="#4D4C94FF"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                <TextBlock Text="PRO"
                                           FontSize="7.5"
                                           FontWeight="Bold"
                                           Foreground="#9CC4FF" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding OpenOutputFolderCommand}"
                                    ToolTip="Open recordings folder — Desktop\ASP">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="SettingsButton_Click"
                                    ToolTip="Studio settings">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="MinimizeButton_Click"
                                    ToolTip="Hide to tray">
                                <TextBlock Text="&#xE921;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Button>
                            <Button Style="{StaticResource WindowCloseButtonStyle}"
                                    Click="CloseButton_Click"
                                    ToolTip="Hide to tray — recording continues">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ================= STATUS HERO ================= -->
                    <Border Grid.Row="2"
                            Style="{StaticResource GlassCardStyle}"
                            Padding="0"
                            ClipToBounds="True">
                        <Grid>
                            <Border Background="{StaticResource HeroGlowBrush}"
                                    CornerRadius="17"
                                    Margin="1" />
                            <Ellipse Width="230"
                                     Height="230"
                                     Stroke="#14FFFFFF"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-116,-60,0"
                                     IsHitTestVisible="False" />
                            <Ellipse Width="152"
                                     Height="152"
                                     Stroke="#123EDBFF"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,-28,-62"
                                     IsHitTestVisible="False" />

                            <Grid Margin="15,13,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource PillBorderStyle}"
                                                Background="#2EFF3159"
                                                BorderBrush="#66FF3159">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="StatusDot"
                                                         Width="6"
                                                         Height="6"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="{x:Type Ellipse}">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActivelyRecording}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Starting">
                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Stopping">
                                                                    <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusBadge}"
                                                           Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="#FFD9E6" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource PillBorderStyle}"
                                                Margin="6,0,0,0"
                                                Background="#1FFFFFFF"
                                                BorderBrush="#26FFFFFF"
                                                Padding="7,4">
                                            <TextBlock Text="{Binding EncodingHint}"
                                                       FontSize="7.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusTitle}"
                                               Style="{StaticResource HeroTitleTextStyle}"
                                               FontSize="23"
                                               LineHeight="27"
                                               Margin="0,8,0,0"
                                               MaxWidth="235" />

                                    <TextBlock Text="{Binding StatusSubtitle}"
                                               Margin="0,4,0,0"
                                               FontSize="10.5"
                                               LineHeight="15"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="235" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            MinWidth="100">
                                    <TextBlock Text="{Binding ElapsedText}"
                                               Style="{StaticResource MonoTimerTextStyle}"
                                               FontSize="27"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="ELAPSED"
                                               Style="{StaticResource CaptionTextStyle}"
                                               FontSize="7.5"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,0,7" />

                                    <TextBlock Text="{Binding TimerStatusText}"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               MaxWidth="112"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTimerWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ProgressBar Style="{StaticResource SlimProgressBarStyle}"
                                                 Height="3"
                                                 Width="104"
                                                 Margin="0,7,0,0"
                                                 HorizontalAlignment="Right"
                                                 Maximum="1"
                                                 Value="{Binding AutoStopFraction, Mode=OneWay}"
                                                 Visibility="{Binding HasAutoStop, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= RECORD ORB ================= -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="116" Height="116">
                            <Ellipse x:Name="AmbientPulse"
                                     Width="108"
                                     Height="108"
                                     Stroke="#A6FF3159"
                                     StrokeThickness="1"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="AmbientPulseScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Button x:Name="RecordButton"
                                    Style="{StaticResource RecordButtonStyle}"
                                    Command="{Binding ToggleRecordingCommand}"
                                    ToolTip="Start or stop a full-screen capture (F9)" />
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CAPTURE"
                                       Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding RecordButtonLabel}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="Click the orb or press F9"
                                       FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,3,0,0" />

                            <Border Style="{StaticResource InsetCardStyle}"
                                    Margin="0,8,0,0"
                                    Padding="8,5"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="9"
                                               Foreground="{StaticResource AccentLightBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OutputFolderDisplay}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="›"
                                               Margin="6,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ================= CAPTURE OPTIONS ================= -->
                    <Border Grid.Row="6"
                            Style="{StaticResource GlassCardStyle}"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="9"
                                        Background="#331D5BFF"
                                        BorderBrush="#3D4C94FF"
                                        BorderThickness="1">
                                    <TextBlock Text="&#xE767;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentLightBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Audio capture"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AudioSummary}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>

                                <CheckBox Grid.Column="2"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding CaptureAudio, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEditCaptureOptions}"
                                          VerticalAlignment="Center"
                                          ToolTip="Include or mute all audio" />
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource DividerStyle}" />

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                    <TextBlock Text="SOURCES"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <CheckBox Content="System"
                                                  Style="{StaticResource ChipCheckBoxStyle}"
                                                  IsChecked="{Binding CaptureSystemAudio, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEditCaptureOptions}" />
                                        <CheckBox Content="Microphone"
                                                  Style="{StaticResource ChipCheckBoxStyle}"
                                                  IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanEditCaptureOptions}"
                                                  Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="AUTO-STOP"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right" />
                                    <ComboBox Width="112"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource GlassComboBoxStyle}"
                                              ItemsSource="{Binding AutoStopOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedAutoStopOption, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditCaptureOptions}"
                                              ToolTip="Automatically stop after a chosen duration" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= RECENT CAPTURES ================= -->
                    <Border Grid.Row="8"
                            Style="{StaticResource GlassCardStyle}"
                            Padding="14,9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="RECENT CAPTURES"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding RecentCountText}"
                                               FontSize="8.5"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Open ASP  ›"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenOutputFolderCommand}" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding RecentRecordings}"
                                              HorizontalContentAlignment="Stretch"
                                              Visibility="{Binding HasRecentRecordings, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="0"
                                                    Margin="0,1"
                                                    ToolTip="{Binding ToolTip}"
                                                    Command="{Binding DataContext.OpenRecordingCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding FilePath}">
                                                <Grid Height="32"
                                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="27"
                                                            Height="27"
                                                            CornerRadius="8"
                                                            Background="#331D5BFF"
                                                            BorderBrush="#334C94FF"
                                                            BorderThickness="1">
                                                        <TextBlock Text="&#xE768;"
                                                                   FontFamily="{StaticResource IconFontFamily}"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource AccentLightBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Meta}"
                                                                   FontSize="8.5"
                                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE8B7;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding HasRecentRecordings, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="Your first capture lands here."
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Full screen video, saved automatically."
                                               FontSize="8.5"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= FOOTER ================= -->
                    <Grid Grid.Row="10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActivelyRecording}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding FooterStatus}"
                                       FontSize="7.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  TRAY ACTIVE"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="#506E86A9" />
                        </StackPanel>

                        <TextBlock Text="F9  ·  START / STOP"
                                   FontSize="7.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- ================= TOAST ================= -->
                <Border x:Name="ToastCard"
                        Visibility="Collapsed"
                        Opacity="0"
                        Panel.ZIndex="50"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="18,0,18,16"
                        MaxWidth="360"
                        Padding="12,10"
                        CornerRadius="13"
                        Background="#F20A1B36"
                        BorderThickness="1"
                        Effect="{StaticResource TooltipShadowEffect}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTranslate" Y="8" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="BorderBrush" Value="#4D45E0B5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                    <Setter Property="BorderBrush" Value="#66FF3B61" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToastWarning}" Value="True">
                                    <Setter Property="BorderBrush" Value="#66FFC46B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="26"
                                Height="26"
                                CornerRadius="8"
                                VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#2645E0B5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                            <Setter Property="Background" Value="#33FF3B61" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToastWarning}" Value="True">
                                            <Setter Property="Background" Value="#33FFC46B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                                <Setter Property="Foreground" Value="#FF8A9D" />
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToastWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding ToastTitle}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ToastMessage}"
                                       FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="280"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
