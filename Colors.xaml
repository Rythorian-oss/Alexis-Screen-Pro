<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core palette: deep cobalt night, electric azure, and a hot recording red. -->
    <Color x:Key="Night950Color">#030A17</Color>
    <Color x:Key="Night900Color">#061226</Color>
    <Color x:Key="Night850Color">#081A33</Color>
    <Color x:Key="Night800Color">#0A2142</Color>
    <Color x:Key="Cobalt700Color">#0B37B8</Color>
    <Color x:Key="Cobalt600Color">#1450F2</Color>
    <Color x:Key="Cobalt500Color">#256BFF</Color>
    <Color x:Key="Cobalt400Color">#4C94FF</Color>
    <Color x:Key="Cyan400Color">#3EDBFF</Color>
    <Color x:Key="Ice100Color">#F4F8FF</Color>
    <Color x:Key="Mist300Color">#A9BEDB</Color>
    <Color x:Key="Mist500Color">#6E86A9</Color>
    <Color x:Key="RecordColor">#FF3B61</Color>
    <Color x:Key="SuccessColor">#45E0B5</Color>
    <Color x:Key="WarningColor">#FFC46B</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2030A17" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Ice100Color}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Mist300Color}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Mist500Color}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Cobalt500Color}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource Cobalt400Color}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan400Color}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource RecordColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="GlassBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderStrongBrush" Color="#59D6E9FF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#660B2140" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#8C10305A" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeHoverBrush" Color="#66A9D3FF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99030A17" />

    <!-- Main window body: semi-transparent cobalt glass over the DWM acrylic. -->
    <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C2081730" Offset="0" />
        <GradientStop Color="#B8051226" Offset="0.46" />
        <GradientStop Color="#D20A1E3C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8C0F2C54" Offset="0" />
        <GradientStop Color="#5907162C" Offset="0.55" />
        <GradientStop Color="#7A0C2243" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGlassWarmBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8C14305C" Offset="0" />
        <GradientStop Color="#4D08182F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C9BFF" Offset="0" />
        <GradientStop Color="#1D5BFF" Offset="0.55" />
        <GradientStop Color="#0C36C9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGradientHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3E8CFF" Offset="0" />
        <GradientStop Color="#1D5BFF" Offset="0.6" />
        <GradientStop Color="#663E8CFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RecordGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6C86" Offset="0" />
        <GradientStop Color="#FF3159" Offset="0.58" />
        <GradientStop Color="#D91443" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RecordHaloBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FF3159" Offset="0" />
        <GradientStop Color="#66FF3159" Offset="0.55" />
        <GradientStop Color="#00FF3159" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.72,0.1" GradientOrigin="0.72,0.1" RadiusX="0.85" RadiusY="1.1">
        <GradientStop Color="#4D1D5BFF" Offset="0" />
        <GradientStop Color="#1A1D5BFF" Offset="0.5" />
        <GradientStop Color="#001D5BFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CyanGlowBrush" Center="0.1,0.9" GradientOrigin="0.1,0.9" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#263EDBFF" Offset="0" />
        <GradientStop Color="#003EDBFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="RecordGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
        <GradientStop Color="#B3FF3159" Offset="0" />
        <GradientStop Color="#40FF3159" Offset="0.55" />
        <GradientStop Color="#00FF3159" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.24" />
        <GradientStop Color="#00FFFFFF" Offset="0.7" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DividerGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3EDBFF" Offset="0" />
        <GradientStop Color="#256BFF" Offset="0.75" />
        <GradientStop Color="#7A4C9BFF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="WindowShadowEffect"
                      BlurRadius="46"
                      ShadowDepth="16"
                      Direction="270"
                      Opacity="0.58"
                      Color="#00030C" />

    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="22"
                      ShadowDepth="8"
                      Direction="270"
                      Opacity="0.30"
                      Color="#00030C" />

    <DropShadowEffect x:Key="RecordButtonShadowEffect"
                      BlurRadius="34"
                      ShadowDepth="0"
                      Direction="270"
                      Opacity="0.65"
                      Color="#FF3159" />

    <DropShadowEffect x:Key="AccentGlowEffect"
                      BlurRadius="26"
                      ShadowDepth="0"
                      Direction="270"
                      Opacity="0.45"
                      Color="#1D5BFF" />

    <DropShadowEffect x:Key="TooltipShadowEffect"
                      BlurRadius="18"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.45"
                      Color="#00030C" />

</ResourceDictionary>
