<Window x:Class="AlexisScreenPro.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Studio Settings — Alexis Screen Pro"
        Width="820"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource BodyFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate" Y="0" />
        </Grid.RenderTransform>

        <Border CornerRadius="26"
                Background="{StaticResource WindowGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                Effect="{StaticResource WindowShadowEffect}">
            <Grid>
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,770,670" RadiusX="25" RadiusY="25" />
                </Grid.Clip>

                <Border Background="{StaticResource HeroGlowBrush}"
                        CornerRadius="25"
                        IsHitTestVisible="False" />
                <Border Background="{StaticResource CyanGlowBrush}"
                        CornerRadius="25"
                        Opacity="0.5"
                        IsHitTestVisible="False" />
                <Border Background="{StaticResource GlassSheenBrush}"
                        CornerRadius="25"
                        IsHitTestVisible="False" />

                <Grid Margin="24,18,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="52" />
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="11"
                                    Background="#261D5BFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1">
                                <Image Source="pack://application:,,,/AlexisScreenPro;component/Assets/logo.png"
                                       Margin="2"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STUDIO SETTINGS"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Tune every detail of your capture."
                                           FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource PillBorderStyle}"
                                    Background="#1F1D5BFF"
                                    BorderBrush="#3D4C94FF"
                                    Margin="0,0,10,0">
                                <TextBlock Text="COBALT EDITION"
                                           FontSize="7.5"
                                           FontWeight="Bold"
                                           Foreground="#9CC4FF" />
                            </Border>
                            <Button Style="{StaticResource WindowCloseButtonStyle}"
                                    Click="CloseButton_Click"
                                    ToolTip="Close settings">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- BODY -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <Grid Margin="0,1,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- CAPTURE -->
                                <Border Style="{StaticResource GlassCardStyle}" Padding="17,14">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="#331D5BFF" BorderBrush="#3D4C94FF" BorderThickness="1">
                                                    <TextBlock Text="&#xE714;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Capture engine" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="Quality and performance" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FRAME RATE" Style="{StaticResource CaptionTextStyle}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          Style="{StaticResource GlassComboBoxStyle}"
                                                          ItemsSource="{Binding FrameRateChoices}"
                                                          SelectedItem="{Binding FrameRate, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0} FPS" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="BITRATE" Style="{StaticResource CaptionTextStyle}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          Style="{StaticResource GlassComboBoxStyle}"
                                                          ItemsSource="{Binding BitrateChoicesMbps}"
                                                          SelectedItem="{Binding BitrateMbps, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0} Mbps" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Show mouse cursor" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Include the pointer in your video" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding CaptureCursor, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Hardware encoding" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Faster GPU encode with software fallback" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding UseHardwareEncoding, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AUDIO -->
                                <Border Style="{StaticResource GlassCardStyle}" Padding="17,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="#331D5BFF" BorderBrush="#3D4C94FF" BorderThickness="1">
                                                    <TextBlock Text="&#xE767;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Audio" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="System sound and voice" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <CheckBox HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding CaptureAudio, Mode=TwoWay}"
                                                      ToolTip="Include or mute all audio" />
                                        </Grid>

                                        <Border Style="{StaticResource DividerStyle}" Margin="0,10,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="System audio" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Loopback from your speakers" FontSize="8.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding CaptureSystemAudio, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <ComboBox Margin="0,5,0,0"
                                                  Style="{StaticResource GlassComboBoxStyle}"
                                                  ItemsSource="{Binding SystemAudioDevices}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedSystemAudioOption, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelectSystemDevice}" />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Microphone" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Your voice, precisely synced" FontSize="8.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <ComboBox Margin="0,5,0,0"
                                                  Style="{StaticResource GlassComboBoxStyle}"
                                                  ItemsSource="{Binding MicrophoneDevices}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedMicrophoneOption, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelectMicrophoneDevice}" />

                                        <TextBlock Text="{Binding DeviceSummary}"
                                                   FontSize="8.5"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <!-- BEHAVIOR -->
                                <Border Style="{StaticResource GlassCardStyle}" Padding="17,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="#331D5BFF" BorderBrush="#3D4C94FF" BorderThickness="1">
                                                <TextBlock Text="&#xE823;"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentLightBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Recording behavior" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Timers and background flow" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Auto-stop timer" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Defaults for new captures" FontSize="8.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      Width="120"
                                                      Style="{StaticResource GlassComboBoxStyle}"
                                                      ItemsSource="{Binding AutoStopOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedAutoStopOption, Mode=TwoWay}" />
                                        </Grid>

                                        <Border Style="{StaticResource DividerStyle}" Margin="0,11,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Start minimized" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Launch quietly into the tray" FontSize="8.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Completion notifications" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Tray balloon when a capture is saved" FontSize="8.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding ShowCompletionNotifications, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Launch with Windows" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Sign in ready to capture" FontSize="8.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- STORAGE -->
                                <Border Style="{StaticResource GlassCardStyle}" Padding="17,14" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="#331D5BFF" BorderBrush="#3D4C94FF" BorderThickness="1">
                                                    <TextBlock Text="&#xE8B7;"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Storage" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="Always on your desktop" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding OutputFolderDisplay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding OutputDirectory}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="Open recordings folder"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,9,0,0"
                                                Command="{Binding OpenOutputFolderCommand}" />
                                    </StackPanel>
                                </Border>

                                <!-- TIP -->
                                <Border Background="#261D5BFF"
                                        BorderBrush="#334C94FF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14,12"
                                        Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource CyanBrush}"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Pro workflow" FontSize="10.5" FontWeight="SemiBold" />
                                            <TextBlock Text="Press F9 anywhere in the widget to start or stop. Captures are excluded from the recording window itself."
                                                       FontSize="8.5"
                                                       LineHeight="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- FOOTER -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="10"
                                           Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ValidationMessage}"
                                           Style="{StaticResource ValidationTextStyle}"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Changes apply to your next capture."
                                       FontSize="9"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasValidationMessage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="86" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}"
                                    MinWidth="130">
                                <Grid>
                                    <TextBlock Text="Save changes">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Saving…"
                                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
